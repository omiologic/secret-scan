{
  "name": "@omiologic/secret-scan",
  "description": "Deterministic secret detection and redaction for browser and server JavaScript/TypeScript applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omiologic/secret-scan.git",
    "directory": "packages/javascript"
  },
  "homepage": "https://github.com/omiologic/secret-scan#readme",
  "bugs": {
    "url": "https://github.com/omiologic/secret-scan/issues"
  },
  "keywords": [
    "secret-detection",
    "redaction",
    "security",
    "browser",
    "node"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node-stream": {
      "types": "./dist/adapters/node-stream.d.ts",
      "import": "./dist/adapters/node-stream.js"
    },
    "./web-stream": {
      "types": "./dist/adapters/web-stream.d.ts",
      "import": "./dist/adapters/web-stream.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#native": {
      "node": "./dist/runtime/node.js",
      "browser": "./dist/runtime/browser.js",
      "default": "./dist/runtime/browser.js"
    }
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": "20.x || 22.x || 24.x"
  },
  "version": "0.1.0-beta.1",
  "dependencies": {
    "@omiologic/secret-scan-wasm": "0.1.0-beta.1"
  },
  "optionalDependencies": {
    "@omiologic/secret-scan-darwin-arm64": "0.1.0-beta.1",
    "@omiologic/secret-scan-darwin-x64": "0.1.0-beta.1",
    "@omiologic/secret-scan-linux-arm64-gnu": "0.1.0-beta.1",
    "@omiologic/secret-scan-linux-x64-gnu": "0.1.0-beta.1",
    "@omiologic/secret-scan-win32-arm64-msvc": "0.1.0-beta.1",
    "@omiologic/secret-scan-win32-x64-msvc": "0.1.0-beta.1"
  }
}
