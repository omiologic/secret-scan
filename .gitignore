/_notes/
/.agents/skills/context-governance/
/dist/
/node_modules/

# Built output of the unified npm package (regenerate with
# `npm run js:build`); only the tarball's `dist` is published.
/packages/javascript/dist/
/packages/javascript/node_modules/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Rust build output
/target/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# maturin builds the native extension in place for `maturin develop`
/bindings/python/python/secret_scan/_native*.so
/bindings/python/python/secret_scan/_native*.pyd

# Generated N-API build output (regenerate with `npm install && npm run
# build` in bindings/node); the compiled addon is platform-specific and the
# JS/TypeScript glue is regenerated from src/lib.rs by napi-rs.
/bindings/node/node_modules/
/bindings/node/package-lock.json
/bindings/node/index.js
/bindings/node/index.d.ts
/bindings/node/*.node

# Each npm/<platform> directory under bindings/node ships one published
# package.json plus a compiled addon copied in at publish/qualification time
# (issue #79); only the manifest is tracked.
/bindings/node/npm/*/*.node

# bindings/wasm/npm ships one published package.json plus the
# `wasm-bindgen --target web` output copied in at publish/qualification time
# (issue #79); only the manifest is tracked.
/bindings/wasm/npm/*.js
/bindings/wasm/npm/*.wasm
/bindings/wasm/npm/*.d.ts
