/_notes/
/.agents/skills/context-governance/
/dist/
/node_modules/

# Built output of the unified npm package (regenerate with
# `npm run js:build`); only the tarball's `dist` is published.
/packages/javascript/dist/
/packages/javascript/node_modules/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Rust build output
/target/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# maturin builds the native extension in place for `maturin develop`
/bindings/python/python/secret_scan/_native*.so
/bindings/python/python/secret_scan/_native*.pyd

# Generated N-API build output (regenerate with `npm ci && npm run build`
# in bindings/node); the compiled addon is platform-specific and the
# JS/TypeScript glue is regenerated from src/lib.rs by napi-rs. The lockfile
# is tracked: the qualification matrix installs the build toolchain with
# `npm ci`, which needs one.
/bindings/node/node_modules/
/bindings/node/index.js
/bindings/node/index.d.ts
/bindings/node/*.node

# Generated browser WebAssembly artifact (regenerate with
# `npm run wasm:build`); the glue and the `.wasm` binary are build output.
/bindings/wasm/pkg/
